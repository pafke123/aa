<script language="VBScript">
Function Xb64(b)
    Dim xml, st
    Set xml = CreateObject("MSXML2.DOMDocument")
    xml.LoadXML "<r>" & b & "</r>"
    xml.DocumentElement.DataType = "bin.base64"
    Set st = CreateObject("ADODB.Stream")
    st.Type = 1
    st.Open
    st.Write xml.DocumentElement.NodeTypedValue
    st.Position = 0
    st.Type = 2
    st.Charset = "utf-8"
    Xb64 = st.ReadText
End Function
</script>

